#
# Runs the oracle (original pre-Rust-rewrite) `fasm` command line tool, e.g.:
#
#   tests/oracle/fasm-oracle --canonical examples/many.fasm
#
# Run tests/oracle/setup.sh first to create tests/oracle/venv.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$SCRIPT_DIR/venv/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
  echo "fasm-oracle: $VENV_PY not found; run tests/oracle/setup.sh first" >&2
  exit 1
fi

exec "$VENV_PY" "$SCRIPT_DIR/run_fasm.py" "$@"
