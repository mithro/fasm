#
# Runs the oracle prjuray-tools C++ `xcframes2bit` tool (frames -> .bit,
# --architecture Series7 / UltraScale / UltraScalePlus / Spartan6), built
# by tests/oracle/setup-xilinx.sh as build/xilinx/bin/uray-xcframes2bit,
# e.g.:
#
#   tests/oracle/uray-xcframes2bit-oracle --architecture UltraScalePlus \
#       --frm_file in.frm --output_file out.bit --part_name xczu3eg \
#       --part_file <db>/prjuray-db/zynqusp/xczu3eg-sfvc784-1-e/part.yaml
#
# URAY_ORACLE_DIR overrides the tests/oracle directory whose build/ is used
# (e.g. that of another checkout of this repository).
set -euo pipefail

SCRIPT_DIR="${URAY_ORACLE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
BIN="$SCRIPT_DIR/build/xilinx/bin/uray-xcframes2bit"

if [[ ! -x "$BIN" ]]; then
  echo "uray-xcframes2bit-oracle: $BIN not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

exec "$BIN" "$@"
