# Runs the oracle prjxray C++ `gen_part_base_yaml` tool (debug bitstream ->
# part.yaml), e.g.:
#
#   tests/oracle/gen_part_base_yaml-oracle debug.bit > part.yaml
#
# See docs/rewrite/DESIGN-xilinx-db.md section 8.4 for its flags (-f uses
# FAR registers instead of LOUT ones). Only needed if fasm-xilinx ever
# regenerates part.yaml itself, not for the assemble/write pipeline.
#
# Run tests/oracle/setup-xilinx.sh first to build the binary.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/build/xilinx/bin/gen_part_base_yaml"

if [[ ! -x "$BIN" ]]; then
  echo "gen_part_base_yaml-oracle: $BIN not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

exec "$BIN" "$@"
