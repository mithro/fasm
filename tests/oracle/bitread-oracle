#
# Runs the oracle prjxray C++ `bitread` tool (.bit -> human/machine
# readable frame dump), e.g.:
#
#   tests/oracle/bitread-oracle -o out.bits -z -y in.bit
#
# See docs/rewrite/DESIGN-xilinx-db.md section 8.4 for its full flag set.
# Reads stdin if no bitfile argument is given.
#
# Run tests/oracle/setup-xilinx.sh first to build the binary.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/build/xilinx/bin/bitread"

if [[ ! -x "$BIN" ]]; then
  echo "bitread-oracle: $BIN not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

exec "$BIN" "$@"
