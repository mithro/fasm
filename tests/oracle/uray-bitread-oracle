#
# Runs the oracle prjuray-tools C++ `bitread` tool (.bit -> frames as text,
# with -E and the per architecture frame ECC verification), built by
# tests/oracle/setup-xilinx.sh as build/xilinx/bin/uray-bitread, e.g.:
#
#   tests/oracle/uray-bitread-oracle --architecture UltraScalePlus \
#       --part_file <db>/prjuray-db/zynqusp/xczu3eg-sfvc784-1-e/part.yaml \
#       -z -y design.bit
#
# URAY_ORACLE_DIR overrides the tests/oracle directory whose build/ is used
# (e.g. that of another checkout of this repository).
set -euo pipefail

SCRIPT_DIR="${URAY_ORACLE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
BIN="$SCRIPT_DIR/build/xilinx/bin/uray-bitread"

if [[ ! -x "$BIN" ]]; then
  echo "uray-bitread-oracle: $BIN not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

exec "$BIN" "$@"
