# Runs the oracle prjxray C++ `xc7frames2bit` tool (frames -> .bit), e.g.:
#
#   tests/oracle/xc7frames2bit-oracle --frm_file in.frm --output_file out.bit \
#       --part_name xc7a35tcsg324-1 --part_file <db>/artix7/xc7a35tcsg324-1/part.yaml
#
# See docs/rewrite/DESIGN-xilinx-db.md section 8.4 for its full flag set
# (--architecture defaults to "Series7"; also accepts UltraScale/
# UltraScalePlus/Spartan6).
#
# Run tests/oracle/setup-xilinx.sh first to build the binary.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/build/xilinx/bin/xc7frames2bit"

if [[ ! -x "$BIN" ]]; then
  echo "xc7frames2bit-oracle: $BIN not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

exec "$BIN" "$@"
