# Runs the oracle (f4pga-xc-fasm) `fasm2frames` tool -- FASM -> frames --
# for Series7 parts, e.g.:
#
#   tests/oracle/fasm2frames-oracle --db-root <db>/artix7 \
#       --part xc7a35tcsg324-1 in.fasm out.frm
#
# This is xc_fasm.fasm2frames:main (see docs/rewrite/DESIGN-xilinx-db.md
# section 8.4 for its flags), NOT prjxray's own (broken -- it imports a
# top-level `utils` module that setup-xilinx.sh deliberately never
# installs) `utils.fasm2frames:main` console script of the same name.
#
# Run tests/oracle/setup-xilinx.sh first to create tests/oracle/venv-xilinx.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$SCRIPT_DIR/venv-xilinx/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
  echo "fasm2frames-oracle: $VENV_PY not found; run tests/oracle/setup-xilinx.sh first" >&2
  exit 1
fi

# -P disables prepending the current directory to sys.path for `-m`
# (Python >= 3.11 / PYTHONSAFEPATH=1 on any 3.x): without it, running this
# from the repository root would shadow venv-xilinx's pinned `fasm`/
# `xc_fasm` packages with the live repository's own fasm/ directory. See
# tests/oracle/README.md, "Avoiding the current-directory shadowing pitfall".
exec "$VENV_PY" -P -m xc_fasm.fasm2frames "$@"
