#
# Package config for `find_package(fasm CONFIG)`, generated (via
# CMakePackageConfigHelpers' configure_package_config_file, driven by
# rust/fasm-capi/cmake/generate-config.cmake) and installed to
# PREFIX/lib/cmake/fasm/fasmConfig.cmake by `make capi-install
# PREFIX=...` (see the Makefile's `capi-install` target and
# docs/CAPI.md). Defines two imported targets, matching the static/shared
# choice already offered through pkg-config (fasm.pc, ../fasm.pc.in):
#
#   fasm::fasm_capi          the shared library (libfasm_capi.so/.dylib/.dll)
#   fasm::fasm_capi_static   the static library (libfasm_capi.a/.lib), plus
#                            the system libraries it needs and the
#                            FASM_STATIC compile definition (see
#                            include/fasm/fasm.h: FASM_STATIC drops the
#                            dllimport/dllexport annotations on Windows;
#                            a no-op elsewhere)
#
# Usage:
#
#   find_package(fasm CONFIG REQUIRED)
#   target_link_libraries(my_target PRIVATE fasm::fasm_capi)        # shared
#   target_link_libraries(my_target PRIVATE fasm::fasm_capi_static) # static
#
# with `-Dfasm_DIR=PREFIX/lib/cmake/fasm` (or PREFIX on CMAKE_PREFIX_PATH)
# pointing CMake at this file if PREFIX is not a default search location.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(FASM_INCLUDE_DIR "@PACKAGE_FASM_INCLUDE_DIR@")
set_and_check(FASM_LIB_DIR "@PACKAGE_FASM_LIB_DIR@")

if(NOT TARGET fasm::fasm_capi)
    add_library(fasm::fasm_capi SHARED IMPORTED)
    set_target_properties(fasm::fasm_capi PROPERTIES
        IMPORTED_LOCATION "${FASM_LIB_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}fasm_capi${CMAKE_SHARED_LIBRARY_SUFFIX}"
        INTERFACE_INCLUDE_DIRECTORIES "${FASM_INCLUDE_DIR}"
        # The Rust cdylib is built with no SONAME (there is no versioned
        # libfasm_capi.so.N to claim); without IMPORTED_NO_SONAME, CMake
        # assumes ELF shared libraries always have one and records this
        # target's *build tree path* as the executable's NEEDED entry,
        # which breaks as soon as the library moves or LD_LIBRARY_PATH is
        # used instead (see rust/fasm-capi/tests/c/CMakeLists.txt, which
        # sets the same property for the same reason against a debug
        # build). Set the same way here so a `find_package(fasm CONFIG)`
        # consumer links `-lfasm_capi` (a plain NEEDED "libfasm_capi.so",
        # resolved at run time through rpath/LD_LIBRARY_PATH/ldconfig)
        # instead.
        IMPORTED_NO_SONAME TRUE)
    if(WIN32)
        # Rust's cdylib import library, if present (not built/tested on
        # Windows by this repository's CI, see rust/fasm-capi/tests/c/CMakeLists.txt).
        set_target_properties(fasm::fasm_capi PROPERTIES
            IMPORTED_IMPLIB "${FASM_LIB_DIR}/fasm_capi.dll.lib")
    endif()
endif()

if(NOT TARGET fasm::fasm_capi_static)
    add_library(fasm::fasm_capi_static STATIC IMPORTED)
    set_target_properties(fasm::fasm_capi_static PROPERTIES
        IMPORTED_LOCATION "${FASM_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}fasm_capi${CMAKE_STATIC_LIBRARY_SUFFIX}"
        INTERFACE_INCLUDE_DIRECTORIES "${FASM_INCLUDE_DIR}"
        INTERFACE_COMPILE_DEFINITIONS "FASM_STATIC")
    # The system libraries the Rust standard library needs when statically
    # linked (`cargo rustc -p fasm-capi -- --print native-static-libs`;
    # same set as FASM_NATIVE_LIBS in rust/fasm-capi/tests/c/CMakeLists.txt
    # and @LIBS_PRIVATE@ in ../fasm.pc.in).
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        find_dependency(Threads)
        set_target_properties(fasm::fasm_capi_static PROPERTIES
            INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS};m;rt;util")
    elseif(WIN32)
        set_target_properties(fasm::fasm_capi_static PROPERTIES
            INTERFACE_LINK_LIBRARIES "ws2_32;userenv;ntdll;bcrypt;advapi32;kernel32")
    endif()
endif()

check_required_components(fasm)
