# The f4pga flow's fasm2frames (f4pga-xc-fasm's xc_fasm.fasm2frames, the
# one its xcfasm runs), like tests/oracle/fasm2frames-oracle but in the
# conda environment of tools/e2e/setup-f4pga.sh. The environment's own
# bin/fasm2frames is prjxray's console script, which does not run
# (`from utils.fasm2frames import main`: prjxray's pip package does not
# install its utils/ directory; see tools/e2e/README.md).
root="${F4PGA_E2E_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../build/f4pga" 2>/dev/null && pwd)}"
py="$root/xc7/conda/envs/xc7/bin/python"
if [[ ! -x "$py" ]]; then
  echo "fasm2frames-flow: $py not found; run tools/e2e/setup-f4pga.sh first" >&2
  exit 1
fi
# -I: not the current directory on sys.path (python 3.7 has no -P); from
# the root of this repository "import fasm" would find its fasm/ package.
exec "$py" -I -m xc_fasm.fasm2frames "$@"
