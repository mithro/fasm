.claude/worktrees/

# Rust rewrite: Python oracle (tests/oracle/setup.sh); never committed, each
# machine builds its own.
tests/oracle/venv/
tests/oracle/build/

# Rust rewrite: Xilinx reference tool oracle (tests/oracle/setup-xilinx.sh)
# and its fetched prjxray-db/prjuray-db database cache
# (tools/fetch-db.sh, ${FASM_DB_CACHE:-tests/oracle/build/db}, already
# covered by tests/oracle/build/ above unless FASM_DB_CACHE points
# elsewhere); never committed, each machine builds/fetches its own.
tests/oracle/venv-xilinx/

# Rust rewrite: T7.1 end-to-end toolchain (tools/e2e/setup-openxc7.sh):
# openXC7 snap extraction, OSS CAD Suite, chip databases, downloads cache;
# never committed, each machine sets its own up.
tools/e2e/build/
